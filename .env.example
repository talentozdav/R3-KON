# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL / VITE_SITE_URL: Host URL for self-referential links, referral tracking, and callbacks
APP_URL="https://example.com"
VITE_SITE_URL="https://example.com"

# SUPABASE CONFIGURATION
# Frontend Client (Vite — accessible in browser via import.meta.env only)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# Backend Server (Node.js / Express — server-side only, never bundled in client)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SECRET_KEY="your-service-role-or-secret-key"
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

